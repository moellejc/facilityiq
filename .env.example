# Copy to .env. These values run the local stack with no cloud account.
# Rotate every secret before any shared or production deployment.

# Application role. Row-level security applies to this login.
DATABASE_URL=postgres://facilityiq_app:facilityiq_app_dev@localhost:5432/facilityiq

# Superuser used by migrations and the seed. Bypasses row-level security.
DATABASE_MIGRATE_URL=postgres://facilityiq:facilityiq_dev@localhost:5432/facilityiq

# Worker role. BYPASSRLS so it can dequeue jobs for every organization.
DATABASE_URL_WORKER=postgres://facilityiq_worker:facilityiq_worker_dev@localhost:5432/facilityiq

# Integration tests. Created by the local Postgres setup in the README.
DATABASE_URL_TEST=postgres://facilityiq:facilityiq_dev@localhost:5432/facilityiq_test

# Auth.js. Required. Use a long random value outside local development.
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
AUTH_URL=http://localhost:43123

# S3-compatible storage. Compose points these at MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=facilityiq-models
S3_ACCESS_KEY_ID=facilityiq
S3_SECRET_ACCESS_KEY=facilityiq-dev-secret
S3_FORCE_PATH_STYLE=true

# Optional. The app must run with this empty. Phase 4 may use it to enrich insight language only.
AI_API_KEY=

# Compose runs the seed on boot when this is true. The seed replaces Acme Manufacturing.
SEED_ON_BOOT=true
