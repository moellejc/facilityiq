+import { useRouter } from "next/router";
+import Head from "next/head";
+import { db } from "@/db";
+import { financialMetrics } from "@/db/schema";
+import { CostChart } from "@/components/finance/cost-chart";
+
+export async function getServerSideProps() {
+  const rows = await db.select().from(financialMetrics);
+  return { props: { rows } };
+}
+
+export default function CostByCategoryPage({ params }: { params: { id: string } }) {
+  const router = useRouter();
+  return (
+    <div>
+      <Head><title>Cost by category</title></Head>
+      <CostChart total={rows.reduce((a: number, r: any) => a + Number(r.amount), 0).toFixed(2)} />
+    </div>
+  );
+}
