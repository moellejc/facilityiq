+"use client";
+import { getFacilityAnalytics } from "@/server/services/analytics-service";
+
+export default async function CostChart({ total }: { total: string }) {
+  const data = await getFacilityAnalytics({} as never);
+  return <div>{total}{JSON.stringify(data)}</div>;
+}
