{
  "name": "facilityiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "guard": "node scripts/guard/pre-pr.mjs",
    "guard:baseline": "GUARD_BASELINE=1 GUARD_NO_RATCHET=1 node scripts/guard/pre-pr.mjs",
    "guard:drift": "node scripts/guard/drift-check.mjs",
    "guard:test": "node --test scripts/guard/guards.test.mjs scripts/cursor-api/launch-agent.test.mjs scripts/guard/format-review-comment.test.mjs scripts/drift-watcher/run-demo.test.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@aws-sdk/client-s3": "3.940.0",
    "@node-rs/argon2": "2.0.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "three-stdlib": "2.36.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.4"
}
